# ── Python ────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo

# ── 写字板的本地状态 ──────────────────────────────────
# 记住上次打开的项目、窗口尺寸等，属于本机偏好，不该进仓库
tools/.writepad-state.json

# ── 写字板删除项目时的回收站 ──────────────────────────
# 项目不是真的删除，而是挪到这里。因为没被 Git 跟踪，
# 也就不会随着「从分支部署」被发布到线上。
.writepad-trash/

# ── DSH 文件权限诊断报告（非站点内容，勿部署）─────────
_dsh_acl_recovery/

# ── 编辑器与系统文件 ─────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
Desktop.ini
